# Set the public production URL to enable canonical URLs and sitemap.
NEXT_PUBLIC_SITE_URL=
# Official profile URL, e.g. https://www.instagram.com/verified_handle/
NEXT_PUBLIC_INSTAGRAM_URL=
# Paste only the src attribute from the clinic's exact Google Maps iframe.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=
# Optional static hosting (GitHub Pages workflow sets these automatically).
STATIC_EXPORT=false
NEXT_PUBLIC_BASE_PATH=
